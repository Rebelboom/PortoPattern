<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================== -->
    <!-- SURFACES (БАЗОВЫЕ ПОВЕРХНОСТИ)             -->
    <!-- ========================================== -->
    <SolidColorBrush x:Key="Rebel.Surface.Root" Color="YellowGreen"/>
    <SolidColorBrush x:Key="Rebel.Surface.Default" Color="#0B0F19"/>
    <SolidColorBrush x:Key="Rebel.Surface.Secondary" Color="#111827"/>

    <!-- ========================================== -->
    <!-- CARDS ECOSYSTEM (КАРТОЧКИ)                 -->
    <!-- ========================================== -->
    <!-- Темная индиго-база для карточек -->
    <SolidColorBrush x:Key="Rebel.Surface.Card.Default" Color="#1E1E2E"/>
    <!-- Легкое свечение фона при наведении -->
    <SolidColorBrush x:Key="Rebel.Surface.Card.Hover" Color="#2A2A3C"/>

    <!-- Стандартная граница, сливающаяся с тенями -->
    <SolidColorBrush x:Key="Rebel.Border.Card.Default" Color="#313145"/>
    <!-- Яркая индиго-граница при наведении -->
    <SolidColorBrush x:Key="Rebel.Border.Card.Hover" Color="#818CF8"/>

    <!-- Текст на карточках -->
    <SolidColorBrush x:Key="Rebel.Text.Card" Color="#F1F1F5"/>

    <!-- ========================================== -->
    <!-- SEARCH HIGHLIGHT (ПОДСВЕТКА ПОИСКА)        -->
    <!-- ========================================== -->
    <!-- Фон найденного текста (ядовито-индиго для резкого выделения) -->
    <SolidColorBrush x:Key="Rebel.Highlight.Search.Background" Color="#818CF8"/>
    <!-- Текст поиска (очень темный, почти черный, для четкости на светлом фоне) -->
    <SolidColorBrush x:Key="Rebel.Highlight.Search.Foreground" Color="#0B0F19"/>

    <!-- ========================================== -->
    <!-- ELEMENTS (КНОПКИ И КОНТРОЛЫ)               -->
    <!-- ========================================== -->
    <SolidColorBrush x:Key="Rebel.Element.Default" Color="#3730A3"/>
    <SolidColorBrush x:Key="Rebel.Element.Hover" Color="#4F46E5"/>

    <!-- ========================================== -->
    <!-- BORDERS (ОБЩИЕ ГРАНИЦЫ)                    -->
    <!-- ========================================== -->
    <SolidColorBrush x:Key="Rebel.Border.Default" Color="#1E1B4B"/>
    <SolidColorBrush x:Key="Rebel.Border.Hover" Color="#4338CA"/>

    <!-- ========================================== -->
    <!-- TEXT (ОБЩИЙ ТЕКСТ)                         -->
    <!-- ========================================== -->
    <SolidColorBrush x:Key="Rebel.Text.Primary" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="Rebel.Text.Secondary" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="Rebel.Text.Header" Color="#818CF8"/>

    <SolidColorBrush x:Key="Rebel.Text.Nav.Default" Color="#A5B4FC"/>
    <SolidColorBrush x:Key="Rebel.Text.Nav.Hover" Color="#E0E7FF"/>

    <!-- ========================================== -->
    <!-- GENERAL EFFECTS (ОБЩИЕ ЭФФЕКТЫ)            -->
    <!-- ========================================== -->
    <SolidColorBrush x:Key="Rebel.Highlighter" Color="#6366F1"/>
    <SolidColorBrush x:Key="Rebel.Highlight.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="Rebel.Highlight.Foreground" Color="#818CF8"/>
    <SolidColorBrush x:Key="Rebel.Transparent" Color="Transparent"/>

</ResourceDictionary>