<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- ========================================== -->
        <!-- 1. ТЕМНАЯ ТЕМА (DEFAULT)                   -->
        <!-- ========================================== -->
        <ResourceDictionary x:Key="Default">

            <!-- Системные цвета Windows (перехватываем синий) -->
            <Color x:Key="SystemAccentColor">#6366F1</Color>
            <Color x:Key="SystemAccentColorLight1">#818CF8</Color>
            <Color x:Key="SystemAccentColorLight2">#A5B4FC</Color>
            <Color x:Key="SystemAccentColorLight3">#C7D2FE</Color>
            <Color x:Key="SystemAccentColorDark1">#4F46E5</Color>
            <Color x:Key="SystemAccentColorDark2">#4338CA</Color>
            <Color x:Key="SystemAccentColorDark3">#312E81</Color>

            <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#6366F1" />
            <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="#818CF8" />
            <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="#A5B4FC" />
            <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="#C7D2FE" />
            <SolidColorBrush x:Key="SystemAccentColorDark1Brush" Color="#4F46E5" />
            <SolidColorBrush x:Key="SystemAccentColorDark2Brush" Color="#4338CA" />
            <SolidColorBrush x:Key="SystemAccentColorDark3Brush" Color="#312E81" />

            <!-- NAVIGATION VIEW -->
            <StaticResource
                x:Key="NavigationViewDefaultPaneBackground"
                ResourceKey="Rebel.Surface.Secondary"/>

            <StaticResource
                x:Key="NavigationViewExpandedPaneBackground"
                ResourceKey="Rebel.Transparent"/>

            <!-- ACCENT -->
            <StaticResource
                x:Key="SystemControlBackgroundAccentBrush"
                ResourceKey="Rebel.Accent.Default"/>

            <StaticResource
                x:Key="AccentFillColorDefaultBrush"
                ResourceKey="Rebel.Accent.Default"/>

            <StaticResource
                x:Key="AccentFillColorSecondaryBrush"
                ResourceKey="Rebel.Accent.Hover"/>

            <StaticResource
                x:Key="AccentFillColorTertiaryBrush"
                ResourceKey="Rebel.Accent.Pressed"/>

            <!-- ACCENT / PRIMARY BUTTONS STYLE -->
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="Rebel.Accent.Default"/>
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="Rebel.Accent.Hover"/>
            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="Rebel.Accent.Pressed"/>
            <StaticResource x:Key="AccentButtonBackgroundDisabled" ResourceKey="Rebel.Accent.Disabled"/>
            <StaticResource x:Key="AccentButtonForeground" ResourceKey="Rebel.Text.Primary"/>
            <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="Rebel.Text.Primary"/>
            <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="Rebel.Text.Primary"/>
            <StaticResource x:Key="AccentButtonForegroundDisabled" ResourceKey="Rebel.Text.Disabled"/>

            <!-- TEXT -->
            <StaticResource
                x:Key="TextFillColorPrimaryBrush"
                ResourceKey="Rebel.Text.Primary"/>

            <StaticResource
                x:Key="TextFillColorSecondaryBrush"
                ResourceKey="Rebel.Text.Secondary"/>

            <StaticResource
                x:Key="TextFillColorDisabledBrush"
                ResourceKey="Rebel.Text.Disabled"/>

            <StaticResource
                x:Key="TextOnAccentFillColorPrimaryBrush"
                ResourceKey="Rebel.Text.Primary"/>

            <!-- CONTROLS BACKGROUND -->
            <StaticResource
                x:Key="ControlFillColorDefaultBrush"
                ResourceKey="Rebel.Element.Default"/>

            <StaticResource
                x:Key="ControlFillColorSecondaryBrush"
                ResourceKey="Rebel.Element.Hover"/>

            <StaticResource
                x:Key="ControlFillColorTertiaryBrush"
                ResourceKey="Rebel.Element.Pressed"/>

            <StaticResource
                x:Key="ControlFillColorDisabledBrush"
                ResourceKey="Rebel.Element.Disabled"/>

            <!-- CONTROL FOREGROUND -->
            <StaticResource
                x:Key="ControlForegroundBrush"
                ResourceKey="Rebel.Text.Primary"/>

            <StaticResource
                x:Key="TextControlForeground"
                ResourceKey="Rebel.Text.Primary"/>

            <StaticResource
                x:Key="TextControlForegroundFocused"
                ResourceKey="Rebel.Text.Primary"/>

            <!-- DEFAULT BUTTON -->
            <StaticResource
                x:Key="ButtonBackground"
                ResourceKey="Rebel.Element.Default"/>

            <StaticResource
                x:Key="ButtonBackgroundPointerOver"
                ResourceKey="Rebel.Element.Hover"/>

            <StaticResource
                x:Key="ButtonBackgroundPressed"
                ResourceKey="Rebel.Element.Pressed"/>

            <StaticResource
                x:Key="ButtonForeground"
                ResourceKey="Rebel.Text.Primary"/>

            <StaticResource
                x:Key="ButtonForegroundPointerOver"
                ResourceKey="Rebel.Text.Primary"/>

            <StaticResource
                x:Key="ButtonForegroundPressed"
                ResourceKey="Rebel.Text.Primary"/>

            <!-- BORDERS -->
            <StaticResource
                x:Key="ControlElevationBorderBrush"
                ResourceKey="Rebel.Border.Default"/>

            <StaticResource
                x:Key="ControlStrokeColorDefaultBrush"
                ResourceKey="Rebel.Border.Default"/>

            <StaticResource
                x:Key="ControlStrokeColorSecondaryBrush"
                ResourceKey="Rebel.Border.Hover"/>

        </ResourceDictionary>

        <!-- ========================================== -->
        <!-- 2. СВЕТЛАЯ ТЕМА (LIGHT)                    -->
        <!-- ========================================== -->
        <ResourceDictionary x:Key="Light">

            <!-- Системные цвета Windows (перехватываем синий) -->
            <Color x:Key="SystemAccentColor">#6366F1</Color>
            <Color x:Key="SystemAccentColorLight1">#818CF8</Color>
            <Color x:Key="SystemAccentColorLight2">#A5B4FC</Color>
            <Color x:Key="SystemAccentColorLight3">#C7D2FE</Color>
            <Color x:Key="SystemAccentColorDark1">#4F46E5</Color>
            <Color x:Key="SystemAccentColorDark2">#4338CA</Color>
            <Color x:Key="SystemAccentColorDark3">#312E81</Color>

            <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#6366F1" />
            <SolidColorBrush x:Key="SystemAccentColorLight1Brush" Color="#818CF8" />
            <SolidColorBrush x:Key="SystemAccentColorLight2Brush" Color="#A5B4FC" />
            <SolidColorBrush x:Key="SystemAccentColorLight3Brush" Color="#C7D2FE" />
            <SolidColorBrush x:Key="SystemAccentColorDark1Brush" Color="#4F46E5" />
            <SolidColorBrush x:Key="SystemAccentColorDark2Brush" Color="#4338CA" />
            <SolidColorBrush x:Key="SystemAccentColorDark3Brush" Color="#312E81" />

            <!-- NAVIGATION VIEW -->
            <StaticResource
                x:Key="NavigationViewDefaultPaneBackground"
                ResourceKey="Rebel.Surface.Secondary"/>

            <StaticResource
                x:Key="NavigationViewExpandedPaneBackground"
                ResourceKey="Rebel.Surface.Secondary"/>

            <!-- ACCENT -->
            <StaticResource
                x:Key="SystemControlBackgroundAccentBrush"
                ResourceKey="Rebel.Accent.Default"/>

            <StaticResource
                x:Key="AccentFillColorDefaultBrush"
                ResourceKey="Rebel.Accent.Default"/>

            <StaticResource
                x:Key="AccentFillColorSecondaryBrush"
                ResourceKey="Rebel.Accent.Hover"/>

            <StaticResource
                x:Key="AccentFillColorTertiaryBrush"
                ResourceKey="Rebel.Accent.Pressed"/>

            <!-- ACCENT / PRIMARY BUTTONS STYLE -->
            <StaticResource x:Key="AccentButtonBackground" ResourceKey="Rebel.Accent.Default"/>
            <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="Rebel.Accent.Hover"/>
            <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="Rebel.Accent.Pressed"/>
            <StaticResource x:Key="AccentButtonBackgroundDisabled" ResourceKey="Rebel.Accent.Disabled"/>
            <StaticResource x:Key="AccentButtonForeground" ResourceKey="Rebel.Text.Primary"/>
            <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="Rebel.Text.Primary"/>
            <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="Rebel.Text.Primary"/>
            <StaticResource x:Key="AccentButtonForegroundDisabled" ResourceKey="Rebel.Text.Disabled"/>

            <!-- TEXT -->
            <StaticResource
                x:Key="TextFillColorPrimaryBrush"
                ResourceKey="Rebel.Text.Primary"/>

            <StaticResource
                x:Key="TextFillColorSecondaryBrush"
                ResourceKey="Rebel.Text.Secondary"/>

            <StaticResource
                x:Key="TextFillColorDisabledBrush"
                ResourceKey="Rebel.Text.Disabled"/>

            <StaticResource
                x:Key="TextOnAccentFillColorPrimaryBrush"
                ResourceKey="Rebel.Text.Primary"/>

            <!-- CONTROLS BACKGROUND -->
            <StaticResource
                x:Key="ControlFillColorDefaultBrush"
                ResourceKey="Rebel.Element.Default"/>

            <StaticResource
                x:Key="ControlFillColorSecondaryBrush"
                ResourceKey="Rebel.Element.Hover"/>

            <StaticResource
                x:Key="ControlFillColorTertiaryBrush"
                ResourceKey="Rebel.Element.Pressed"/>

            <StaticResource
                x:Key="ControlFillColorDisabledBrush"
                ResourceKey="Rebel.Element.Disabled"/>

            <!-- CONTROL FOREGROUND -->
            <StaticResource
                x:Key="ControlForegroundBrush"
                ResourceKey="Rebel.Text.Primary"/>

            <StaticResource
                x:Key="TextControlForeground"
                ResourceKey="Rebel.Text.Primary"/>

            <StaticResource
                x:Key="TextControlForegroundFocused"
                ResourceKey="Rebel.Text.Primary"/>

            <!-- DEFAULT BUTTON -->
            <StaticResource
                x:Key="ButtonBackground"
                ResourceKey="Rebel.Element.Default"/>

            <StaticResource
                x:Key="ButtonBackgroundPointerOver"
                ResourceKey="Rebel.Element.Hover"/>

            <StaticResource
                x:Key="ButtonBackgroundPressed"
                ResourceKey="Rebel.Element.Pressed"/>

            <StaticResource
                x:Key="ButtonForeground"
                ResourceKey="Rebel.Text.Primary"/>

            <StaticResource
                x:Key="ButtonForegroundPointerOver"
                ResourceKey="Rebel.Text.Primary"/>

            <StaticResource
                x:Key="ButtonForegroundPressed"
                ResourceKey="Rebel.Text.Primary"/>

            <!-- BORDERS -->
            <StaticResource
                x:Key="ControlElevationBorderBrush"
                ResourceKey="Rebel.Border.Default"/>

            <StaticResource
                x:Key="ControlStrokeColorDefaultBrush"
                ResourceKey="Rebel.Border.Default"/>

            <StaticResource
                x:Key="ControlStrokeColorSecondaryBrush"
                ResourceKey="Rebel.Border.Hover"/>

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>