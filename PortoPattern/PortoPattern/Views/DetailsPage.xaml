<?xml version="1.0" encoding="utf-8"?>
<!-- ****************************************************************************
// Файл: DetailsPage.xaml
// Описание: Страница детального просмотра категории.
// Отображает список папок в виде стилизованных вытянутых карточек с тенью.
// **************************************************************************** -->
<Page
    x:Name="PageRoot"
    x:Class="PortoPattern.Views.DetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:PortoPattern.Controls"
    xmlns:vm="using:PortoPattern.ViewModels"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24,24,0,24">
        <Grid.RowDefinitions>
            <!-- Изменено на фиксированную высоту 100, чтобы соответствовать дизайну страницы результатов -->
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Интегрирован TopToolBar вместо обычного TextBlock. Связываем с Header и SearchText -->
        <controls:TopToolBar
            Grid.Row="0"
            Title="{x:Bind ViewModel.Header, Mode=OneWay}"
            SearchText="{x:Bind ViewModel.SearchText, Mode=TwoWay}"/>

        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      Padding="0,0,24,0">

            <!-- Источник данных изменен с Folders на FilteredFolders для поддержки поиска -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.FilteredFolders, Mode=OneWay}">

                <!-- Используем StackPanel с отступом Spacing="16", чтобы раздвинуть карточки -->
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="16"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FolderCardViewModel">

                        <!-- Добавлен атрибут SearchText с привязкой через ElementName к корневой странице -->
                        <controls:FolderCard 
                                SearchText="{Binding ViewModel.SearchText, ElementName=PageRoot}"
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource Porto.Element.Default}"
                                BorderBrush="{ThemeResource Porto.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Foreground="{ThemeResource Porto.Text.Default}"
                                PointerOverBackgroundCustom="{ThemeResource Porto.Element.Hover}"
                                PointerOverBorderBrushCustom="{ThemeResource Porto.Border.Hover}"
                                PointerOverForegroundCustom="{ThemeResource Porto.Text.Hover}"/>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </ScrollViewer>
    </Grid>
</Page>