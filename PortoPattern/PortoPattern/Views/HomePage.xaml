<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PortoPattern.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PortoPattern.ViewModels"
    xmlns:controls="using:PortoPattern.Controls"
    Background="{ThemeResource Rebel.Transparent}">

    <Grid Padding="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Spacing="8" Margin="0,0,0,40">
            <TextBlock Text="Домашняя страница" 
                       FontSize="30" 
                       FontWeight="Bold" 
                       Foreground="{ThemeResource Rebel.Text.Header}"/>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                       FontSize="16" 
                       Foreground="{ThemeResource Rebel.Text.Secondary}"/>

            <ProgressBar IsIndeterminate="True" 
                         Foreground="{ThemeResource Rebel.Highlighter}"
                         Visibility="{x:Bind ViewModel.IsLoadingVisibility, Mode=OneWay}"
                         Margin="0,10,0,0"/>
        </StackPanel>

        <ItemsControl Grid.Row="1" ItemsSource="{x:Bind ViewModel.QuickActions, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:QuickActionViewModel">
                    <controls:CardButton Width="280" Height="160" Margin="0,0,16,16"
                                         Command="{x:Bind NavigateCommand}"
                                         Background="{ThemeResource Rebel.Surface.Card.Default}"
                                         BorderBrush="{ThemeResource Rebel.Border.Card.Default}"
                                         Foreground="{ThemeResource Rebel.Text.Card}"
                                         BorderThickness="1"
                                         CornerRadius="12"
                                         PointerOverBackgroundCustom="{ThemeResource Rebel.Surface.Card.Hover}"
                                         PointerOverBorderBrushCustom="{ThemeResource Rebel.Border.Card.Hover}"
                                         PointerOverForegroundCustom="{ThemeResource Rebel.Text.Card}"
                                         Style="{StaticResource DefaultCardButtonStyle}">
                        <Grid Padding="24">
                            <StackPanel Spacing="12" VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind Icon}" FontSize="32" />
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" 
                                               FontWeight="Bold" FontSize="18" />
                                    <TextBlock Text="{x:Bind Description}" 
                                               FontSize="13" 
                                               Foreground="{ThemeResource Rebel.Text.Secondary}"
                                               TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </controls:CardButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Page>