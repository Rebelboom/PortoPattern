<?xml version="1.0" encoding="utf-8"?>
<!-- **************************************************************************
// File: SettingsPage.xaml
// Description: Страница настроек с интерфейсом управления темой приложения.
// ************************************************************************** -->
<Page
    x:Class="PortoPattern.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource Rebel.Transparent}"
    mc:Ignorable="d">

    <Grid Padding="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Заголовок страницы -->
        <TextBlock 
            Grid.Row="0"
            Text="Настройки" 
            Style="{ThemeResource TitleTextBlockStyle}" 
            Margin="0,0,0,24" />

        <!-- Содержимое настроек -->
        <StackPanel Grid.Row="1" Spacing="24">
            
            <!-- Секция: Внешний вид -->
            <StackPanel Spacing="8">
                <TextBlock 
                    Text="Внешний вид" 
                    Style="{ThemeResource BodyStrongTextBlockStyle}" />
                
                <!-- Карточка настройки темы -->
                <Grid 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE790;" Grid.Column="0" Margin="0,0,16,0" FontSize="20" VerticalAlignment="Center" />
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Тема приложения" FontWeight="SemiBold" />
                        <TextBlock Text="Переключение между светлой и темной темой" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    
                    <ToggleSwitch 
                        Grid.Column="2"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        OnContent="Тёмная"
                        OffContent="Светлая"
                        IsOn="{Binding IsDarkMode, Mode=TwoWay}" />
                </Grid>
            </StackPanel>

        </StackPanel>
    </Grid>
</Page>